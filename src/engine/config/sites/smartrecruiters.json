{
  "ats": "SmartRecruiters",
  "urls": [
    "*://jobs.smartrecruiters.com/oneclick-ui/*"
  ],
  "urlsExcluded": [],
  "embeddedPaths": [],
  "pathsExcluded": [],
  "containerPath": [],
  "containerRequired": false,
  "defaultMethod": "default",
  "submitButtonPaths": [],
  "submittedSuccessPaths": [],
  "trackedInputSelectors": [
    {
      "kind": "file",
      "label": "Resume",
      "fieldPath": "//*[@data-test='resume-upload']/shadow-root/input[@type='file']",
      "labelPath": [
        "ancestor::*[@data-test='resume-upload-container'][1]//*[@data-test='section-title']"
      ],
      "fillActions": [
        {
          "method": "uploadFile"
        }
      ]
    }
  ],
  "inputSelectors": [
    [
      "first_name",
      [
        "//input[@id='first-name-input']"
      ]
    ],
    [
      "last_name",
      [
        "//input[@id='last-name-input']"
      ]
    ],
    [
      "email",
      [
        "//input[@id='email-input']"
      ]
    ],
    [
      "email_confirm",
      [
        "//input[@id='confirm-email-input']"
      ]
    ],
    [
      "phone",
      [
        "//input[@type='tel'][@aria-label='Phone number']"
      ]
    ],
    [
      "city",
      [
        {
          "path": [
            "//spl-autocomplete[@label='City']/shadow-root/spl-input/shadow-root/input"
          ],
          "method": "trustedChoose"
        },
        "//spl-autocomplete[@label='City']//input",
        "//spl-input[@label='City']/shadow-root/input"
      ]
    ],
    [
      "linkedin",
      [
        "//input[@id='linkedin-input']"
      ]
    ],
    [
      "website",
      [
        "//input[@id='website-input']"
      ]
    ],
    [
      "experience",
      [
        {
          "containerPath": [
            ".//oc-experience-entry[.//div[@data-test='experience-edit-form']]"
          ],
          "addButtonPath": [
            ".//*[@data-test='add-experience']"
          ],
          "savedRowPath": [
            ".//oc-experience-entry[not(.//div[@data-test='experience-edit-form'])]"
          ],
          "inputSelectors": [
            [
              "title",
              [
                {
                  "path": [
                    ".//*[@data-test='job-title-autocomplete']/shadow-root/spl-input/shadow-root/input",
                    ".//*[@data-test='job-title-autocomplete']/shadow-root/input",
                    ".//*[@data-test='job-title-autocomplete']//input"
                  ],
                  "method": "trustedChoose"
                }
              ]
            ],
            [
              "company",
              [
                {
                  "path": [
                    ".//*[@data-test='company-autocomplete']/shadow-root/spl-input/shadow-root/input",
                    ".//*[@data-test='company-autocomplete']/shadow-root/input",
                    ".//*[@data-test='company-autocomplete']//input"
                  ],
                  "method": "trustedChoose"
                }
              ]
            ],
            [
              "location",
              [
                {
                  "path": [
                    ".//*[@data-test='location-autocomplete']/shadow-root/spl-input/shadow-root/input",
                    ".//*[@data-test='location-autocomplete']/shadow-root/input",
                    ".//*[@data-test='location-autocomplete']//input"
                  ],
                  "method": "trustedChoose"
                }
              ]
            ],
            [
              "description_stripped",
              [
                ".//*[@data-test='experience-description']//spl-textarea/shadow-root/textarea",
                ".//*[@data-test='experience-description']//textarea"
              ]
            ],
            [
              "start_date",
              [
                {
                  "path": [
                    ".//*[@data-test='experience-date-from']//spl-date-field/shadow-root/spl-date-picker/shadow-root/input[contains(@class,'flatpickr-input')]"
                  ],
                  "method": "pickMonth"
                }
              ]
            ],
            [
              "end_date",
              [
                {
                  "path": [
                    ".//*[@data-test='experience-date-to']//spl-date-field/shadow-root/spl-date-picker/shadow-root/input[contains(@class,'flatpickr-input')]"
                  ],
                  "method": "pickMonth"
                }
              ]
            ],
            [
              "currently_working",
              [
                ".//*[@data-test='experience-current']//spl-checkbox/shadow-root/input[@type='checkbox']",
                ".//*[@data-test='experience-current']//input[@type='checkbox']"
              ]
            ],
            [
              "save",
              [
                {
                  "path": [
                    ".//*[@data-test='experience-save']"
                  ],
                  "method": "click",
                  "valueRequired": false
                }
              ]
            ]
          ]
        }
      ]
    ],
    [
      "education",
      [
        {
          "containerPath": [
            ".//oc-education-entry[.//div[@data-test='education-edit-form']]"
          ],
          "addButtonPath": [
            ".//*[@data-test='add-education']"
          ],
          "savedRowPath": [
            ".//oc-education-entry[not(.//div[@data-test='education-edit-form'])]"
          ],
          "inputSelectors": [
            [
              "school",
              [
                {
                  "path": [
                    ".//*[@data-test='institution-autocomplete']/shadow-root/spl-input/shadow-root/input"
                  ],
                  "method": "trustedChoose"
                }
              ]
            ],
            [
              "major",
              [
                {
                  "path": [
                    ".//*[@data-test='education-major']//spl-input/shadow-root/input"
                  ],
                  "method": "trustedType"
                }
              ]
            ],
            [
              "degree",
              [
                {
                  "path": [
                    ".//*[@data-test='education-degree']//spl-input/shadow-root/input"
                  ],
                  "method": "trustedType"
                }
              ]
            ],
            [
              "location",
              [
                {
                  "path": [
                    ".//*[@data-test='education-form-location']//*[@data-test='location-autocomplete']/shadow-root/spl-input/shadow-root/input"
                  ],
                  "method": "trustedChoose"
                }
              ]
            ],
            [
              "start_date",
              [
                {
                  "path": [
                    ".//*[@data-test='education-date-from']//spl-date-field/shadow-root/spl-date-picker/shadow-root/input[contains(@class,'flatpickr-input')]"
                  ],
                  "method": "pickMonth"
                }
              ]
            ],
            [
              "end_date",
              [
                {
                  "path": [
                    ".//*[@data-test='education-date-to']//spl-date-field/shadow-root/spl-date-picker/shadow-root/input[contains(@class,'flatpickr-input')]"
                  ],
                  "method": "pickMonth"
                }
              ]
            ],
            [
              "description",
              [
                ".//*[@data-test='education-description']//spl-textarea/shadow-root/textarea"
              ]
            ],
            [
              "save",
              [
                {
                  "path": [
                    ".//*[@data-test='education-save']"
                  ],
                  "method": "click",
                  "valueRequired": false
                }
              ]
            ]
          ]
        }
      ]
    ]
  ]
}
