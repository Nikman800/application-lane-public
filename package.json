{
  "name": "application-lane",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:store": "node scripts/build.mjs --store",
    "start": "node scripts/start.mjs",
    "dev": "node --watch-path=src --import tsx src/server/index.ts",
    "setup": "node --import tsx src/server/setup.ts",
    "check": "tsc --noEmit",
    "test": "node scripts/test-unit.mjs",
    "test:browser": "playwright test --grep-invert \"throughput benchmark\"",
    "benchmark": "playwright test --grep \"throughput benchmark\"",
    "verify": "npm run check && npm test && npm run build && npm run test:browser",
    "validate": "node --import tsx scripts/validate.ts",
    "tailoring:import": "node --import tsx scripts/tailoring-import.ts",
    "lane": "node --import tsx scripts/lane.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.5.1",
    "mammoth": "^1.10.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.54",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.0.329",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "prettier": "^3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.8.3"
  },
  "bin": {
    "application-lane": "dist/server/index.mjs",
    "lane": "dist/server/lane.mjs"
  },
  "files": [
    "dist/server/",
    "tailor/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ]
}
